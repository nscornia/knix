          }
        },
        "typescript": {
          "always_load": false,
          "barrel_reexport_ceiling": 50,
          "command": {
            "coverage": "npm test --silent -- --coverage 2>/dev/null || npx vitest run --coverage 2>/dev/null || npx jest --coverage 2>/dev/null",
            "dead_code": {
              "command": "npx knip --include exports,files,types --reporter compact",
              "install": "npm install --save-dev knip"
            },
            "lint": "npm run lint --silent",
