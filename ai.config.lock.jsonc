          }
        },
        "gitlab-ci": {
          "always_load": false,
          "command": {
            "coverage": null,
            "lint": "gitlab-ci-lint",
            "test": null
          },
          "companion_files": [
            "RUNBOOK.md",
            "PIPELINE.md"
          ],
          "coverage_target": null,
          "tech_debt": {
            "patterns": [
              "unpinned-shared-template-extends",
              "missing-interruptible",
              "rules-when-always-no-if",
              "hardcoded-credentials-variables",
              "missing-timeout-external-resources",
              "mixed-version-extends",
              "missing-stages",
              "missing-workflow-rules"
            ]
          }
        },
        "go": {
          "always_load": false,
          "command": {
            "coverage": "go test -cover ./... 2>/dev/null | awk '/coverage:/ { print $0 }'",
            "dead_code": {
              "command": "deadcode ./...",
              "install": "go install golang.org/x/tools/cmd/deadcode@latest"
            },
            "lint": "go vet ./...",
            "mutation": "gremlins unleash ./<target>",
            "test": "go test -race ./...",
            "test_target": "go test -race -cover ./<target-package>/..."
          },
          "companion_files": [
            "PROJECT_KNOWLEDGE.md",
            "PLATFORM_KNOWLEDGE.md",
            "KNOWLEDGE.md",
            "NOTES.md"
          ],
          "generated_paths": [
            "vendor/",
            "*.pb.go",
            "*_gen.go",
            "*_mock.go"
          ],
          "tech_debt": {
            "constructor_verbs": [
              "New",
              "Connect",
              "Dial",
              "Open",
              "Load"
            ],
            "patterns": [
              "IF-suffix-interfaces",
              "I-prefix-interfaces",
              "pkg-errors-double-wrap",
              "package-init-singletons",
              "interface-returning-constructor-mono-impl"
            ],
            "wrap_sources": [
              "svcerr",
              "errs",
              "errcode"
            ]
          }
        },
        "javascript": {
          "always_load": false,
          "command": {
            "coverage": null,
            "dead_code": {
              "command": "npx knip --include exports,files,types --reporter compact",
              "install": "npm install --save-dev knip"
            },
            "lint": "npx eslint . --cache",
            "test": "npm test --silent"
          },
          "companion_files": [
            "NOTES.md",
            "ARCHITECTURE.md",
            "GLOSSARY.md"
          ],
          "generated_paths": [
            "dist/",
            "build/",
            "out/",
            "*.min.js",
            "*.config.{js,mjs,cjs}",
            ".eslintrc.{js,cjs}"
          ],
          "tech_debt": {
            "patterns": []
          }
        },
        "jest": {
          "always_load": false,
          "command": {
            "coverage": "npx jest --coverage --coverageReporters=text-summary --ci 2>/dev/null | awk '/Statements/ { gsub(/%/, \"\", $3); print $3 }'",
            "lint": "npx eslint . --ext .ts,.tsx,.js,.jsx --cache",
            "test": "npx jest --passWithNoTests --ci",
            "test_target": "npx jest --coverage --collectCoverageFrom=<source-path> <spec-path>"
          },
          "companion_files": [],
          "tech_debt": {
            "patterns": []
          }
        },
        "karma": {
          "always_load": false,
          "command": {
            "coverage": "npm test -- --code-coverage --watch=false --browsers=ChromeHeadless",
            "lint": "npm run lint",
            "test": "npm test",
            "test_target": "npx ng test --no-watch --code-coverage --include='<glob to spec>'"
          },
          "companion_files": [
            "TEST_HARNESS.md",
            "MOCKING.md"
          ],
          "tech_debt": {
            "patterns": [
              "jest-api-in-karma-project",
              "testbed-reconfiguration-per-it"
