          },
          "companion_files": [
            "NOTES.md",
            "ARCHITECTURE.md",
            "GLOSSARY.md"
          ],
          "generated_paths": [
            "dist/",
            "build/",
            "third-party *.d.ts"
          ],
          "tech_debt": {
            "patterns": [
              "I-prefix-interfaces",
              "default-export-for-named-concepts",
              "namespace-declarations",
              "exported-enums-in-public-api"
            ]
          }
        },
        "vitest": {
          "always_load": false,
          "command": {
            "coverage": "npx vitest run --coverage --coverage.reporter=text 2>/dev/null | awk -F'|' '/All files/ { gsub(/ /, \"\", $2); print $2 }'",
            "lint": "npx eslint . --ext .ts,.tsx,.js,.jsx --cache",
            "test": "npx vitest run --passWithNoTests",
