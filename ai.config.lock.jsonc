    "shared": {
      "budget": {
        "directive_tokens": 2000,
        "directive_total_tokens": 6000,
        "directive_verbs": [
          "read",
          "consult",
          "review",
          "reference",
          "check"
        ],
        "glossary_tokens": 2000,
        "preamble_tokens": 1250,
        "session_start_tokens": 15000,
        "tool_output_tokens": 7500
      },
      "git": {
        "default_branch": "auto",
        "forge": "auto",
        "harness_branches": [],
        "initials": null,
        "remote": "origin"
      },
      "jira": {
        "ignore_prefixes": [
          "UAC"
        ],
        "key_pattern": "[A-Z][A-Z0-9_]{1,9}-\\d+"
      },
      "language": {
        "buf": {
          "always_load": false,
          "command": {
            "breaking": "buf breaking --against \".git#branch=$BASE\"",
            "format": "buf format -d",
            "lint": "buf lint"
          },
          "companion_files": [
            "BUF-WORKSPACE.md",
            "MIGRATION-GUIDE.md"
          ],
          "coverage_target": null,
          "tech_debt": {
            "patterns": [
              "legacy-prototool-alongside-buf-yaml",
              "vendored-googleapis-copies",
              "inline-http-transcoding-without-gateway-config",
              "unversioned-package-paths"
