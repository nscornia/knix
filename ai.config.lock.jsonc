            "lint": "npx eslint . --cache",
            "test": "node --test",
            "test_target": "node --test <target-path>"
          },
          "tech_debt": {
            "patterns": []
          }
        },
        "python": {
          "always_load": false,
          "command": {
            "coverage": "pytest --cov=. --cov-report=term 2>/dev/null | awk '/^TOTAL/ { print $NF }' | tr -d '%'",
            "dead_code": {
