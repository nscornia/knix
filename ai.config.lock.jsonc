      },
      "secret": {
        "pattern": {
          "anthropic-key": {
            "flags": "g",
            "regex": "sk-ant-[A-Za-z0-9_-]{20,}",
            "replacement": "[REDACTED:anthropic-key]"
          },
          "api-key": {
            "flags": "g",
            "regex": "\\bsk-[A-Za-z0-9]{16,}\\b",
            "replacement": "[REDACTED:api-key]"
          },
          "aws-key": {
            "flags": "g",
            "regex": "\\bAKIA[0-9A-Z]{16}\\b",
            "replacement": "[REDACTED:aws-key]"
          },
          "aws-temp-key": {
            "flags": "g",
            "regex": "\\bASIA[0-9A-Z]{16}\\b",
            "replacement": "[REDACTED:aws-temp-key]"
          },
          "env-secret": {
            "flags": "gi",
            "regex": "\\b([A-Za-z0-9_]*(?:KEY|SECRET|TOKEN|PASSWORD|PASSWD|CREDENTIALS?))\\s*[=:]\\s*[\"']?[^\\s\"'`,;]{6,}",
            "replacement": "$1=[REDACTED:env-secret]"
          },
          "github-token": {
            "flags": "g",
            "regex": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b",
            "replacement": "[REDACTED:github-token]"
          },
          "gitlab-token": {
            "flags": "g",
            "regex": "\\bglpat-[A-Za-z0-9_-]{8,}\\b",
            "replacement": "[REDACTED:gitlab-token]"
          },
          "google-key": {
            "flags": "g",
            "regex": "\\bAIza[A-Za-z0-9_-]{20,}\\b",
            "replacement": "[REDACTED:google-key]"
          },
          "hex": {
            "flags": "g",
            "regex": "\\b[0-9a-fA-F]{64,}\\b",
            "replacement": "[REDACTED:hex]"
          },
          "jwt": {
            "flags": "g",
            "regex": "\\beyJ[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{6,}\\b",
            "replacement": "[REDACTED:jwt]"
          },
          "private-key": {
            "flags": "g",
            "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|$)",
            "replacement": "[REDACTED:private-key]"
          },
          "slack-token": {
            "flags": "g",
            "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
            "replacement": "[REDACTED:slack-token]"
          },
          "token": {
            "flags": "g",
            "regex": "\\bBearer\\s+[A-Za-z0-9._~+/-]{12,}=*",
            "replacement": "Bearer [REDACTED:token]"
          },
          "url-credential-token-only": {
            "flags": "g",
            "regex": "\\b([a-zA-Z][a-zA-Z0-9+.-]*:\\/\\/)[^/\\s:]+@",
            "replacement": "$1[REDACTED:url-credential]@"
          },
          "url-credential-user-pass": {
            "flags": "g",
            "regex": "\\b([a-zA-Z][a-zA-Z0-9+.-]*:\\/\\/[^/\\s:@]*:)[^/\\s]+@",
            "replacement": "$1[REDACTED:url-credential]@"
          }
        }
      },
      "test": {
        "level": {
          "component": {
            "blocks": false,
            "budget_ms": 60000,
            "cap_ms": 2000,
            "class": "temp-dir",
            "command": null,
            "concurrency": "shared",
            "reusable": true,
            "run_point": "commit"
