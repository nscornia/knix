              "solution": {
                "id": null,
                "name": "Solution"
              },
              "story_points": {
                "id": null,
                "name": "Story Points"
              }
            },
            "format": {
              "branch": "<initials>/<ISSUE-KEY>-<short-slug>",
              "commit_subject": "<ISSUE-KEY>: <subject>",
              "mr_description": "include the issue key in the body",
              "mr_title": "<ISSUE-KEY> <summary>"
            },
            "link": {
              "branch_name": {
                "github": "<REPO_URL>/tree/<branch>",
                "gitlab": "<REPO_URL>/-/tree/<branch>"
              },
              "commit_sha": {
                "github": "<REPO_URL>/commit/<sha>",
                "gitlab": "<REPO_URL>/-/commit/<sha>"
              },
              "jira_ticket_key": "<JIRA_URL>/browse/<KEY>",
              "known_repo_project_url": "use URL as-is",
              "mr_pr_url": "use URL as-is",
              "npm_package": "https://www.npmjs.com/package/<name>"
            },
            "readiness": [
              "a clear summary",
              "a description of why",
              "acceptance criteria / definition of done",
              "correct parent linkage for the issue type",
              "known dependencies / links / blockers",
              "assignee",
              "story points"
            ]
          },
          "form_check_phrase": {
            "placeholders": [
              "needs refinement",
              "tbd",
              "to be determined",
              "todo",
              "???",
              "fixme"
            ],
            "scope_hints": [
              "non-goal",
              "out of scope",
              "not in scope",
              "excluded",
              "scope:"
            ],
            "size_hints": [
              "appetite",
              "story point",
              "small",
              "medium",
              "large",
              "t-shirt"
            ],
            "vague_assertions": [
              "works correctly",
              "works as expected",
              "works properly",
              "behaves correctly",
              "is correct",
              "is successful",
              "succeeds",
              "functions properly",
              "no issues",
              "as expected",
              "properly handled"
