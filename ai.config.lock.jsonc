        },
        "coverage_target": 80,
        "docker": {
          "always_load": false,
          "command": {
            "coverage": null,
            "lint": "hadolint Dockerfile",
            "test": null
          },
          "companion_files": [
            "RUNBOOK.md",
            "DEPLOYMENT.md"
          ],
          "coverage_target": null,
          "tech_debt": {
            "patterns": [
              "user-root-final-stage",
              "latest-tag-base-image",
              "apt-get-install-recommends",
              "add-url-no-checksum",
              "copy-dot-no-dockerignore",
              "single-stage-compiled-language",
              "missing-healthcheck",
              "missing-expose"
