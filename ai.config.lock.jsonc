      "tools": {
        "aha": {
          "api": {
            "aha": {
              "auth": {
                "scheme": "bearer"
              },
              "credential": [
                "AHA_API_TOKEN",
                "AHA_TOKEN"
              ],
              "request": "/api/v1/me",
              "url": {
                "env": [
                  "AHA_HOST"
                ]
              }
            }
          }
        },
        "atlassian": {
          "api": {
            "confluence": {
              "auth": {
                "scheme": "basic"
              },
              "credential": [
                {
                  "token": "CONFLUENCE_API_TOKEN",
                  "user": "CONFLUENCE_USERNAME"
                },
                {
                  "token": "JIRA_API_TOKEN",
                  "user": "JIRA_USERNAME"
                }
              ],
              "request": "/wiki/rest/api/user/current",
