{
  "name": "knix",
  "private": true,
  "description": "Monorepo for the @knix, @knix-law and @knix-ai packages.",
  "license": "MIT",
  "author": "Nic Cornia",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nscornia/knix.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/utils",
    "packages/law/*",
    "packages/ai/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "check:law-links": "node scripts/check-law-links.mjs",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspaces --if-present"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
